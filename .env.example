# Copy to .env.local and fill in values
BASE_PATH=/hatrecruitment

# Auth — generate a random secret: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-secret

# Initial admin account (hash with: node -e "const b=require('bcryptjs');console.log(b.hashSync('yourpassword',12))")
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2b$12$...

# Local LLM (Ollama on nhomenix01)
OLLAMA_URL=http://192.168.0.14:11434
OLLAMA_MODEL=qwen2.5-coder:32b
